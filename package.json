{
  "name": "email-prefix-suffix-validator",
  "version": "0.0.1",
  "description": "Validate email addresses by prefix (local part) and suffix (domain) rules",
  "type": "module",
  "main": "./dist/main.cjs",
  "module": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/main.d.ts",
        "default": "./dist/main.js"
      },
      "require": {
        "types": "./dist/main.d.cts",
        "default": "./dist/main.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "author": {
    "name": "FalaAiMatheus",
    "url": "https://github.com/FalaAiMatheus"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FalaAiMatheus/email-prefix-suffix-validator.git"
  },
  "bugs": {
    "url": "https://github.com/FalaAiMatheus/email-prefix-suffix-validator/issues"
  },
  "homepage": "https://github.com/FalaAiMatheus/email-prefix-suffix-validator#readme",
  "keywords": [
    "email",
    "email-validator",
    "email-validation",
    "validator",
    "validation",
    "prefix",
    "suffix",
    "domain",
    "email-domain",
    "domain-whitelist",
    "allowlist",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.8.1",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  }
}
